          "mode": "indirect",
          "tagPath": "{1}/Val/Val_PVEUMax",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.HiHiLim": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Cfg/Cfg_HiHiLim",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.HiLim": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Cfg/Cfg_HiLim",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.LoLim": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Cfg/Cfg_LoLim",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.LoLoLim": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Cfg/Cfg_LoLoLim",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.AHiHi": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm/Alm_HiHi",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.AHi": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm/Alm_Hi",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.ALo": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm/Alm_Lo",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.ALoLo": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm/Alm_LoLo",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.Sev": {
      "binding": {
        "config": {
          "expression": "floor({view.custom.Notify}/2)%8"
        },
        "type": "expr"
      }
    },
    "custom.Unack": {
      "binding": {
        "config": {
          "expression": "{view.custom.Notify}%2"
        },
        "type": "expr"
      }
    },
    "custom.SevColor": {
      "binding": {
        "config": {
          "expression": "switch({view.custom.Sev},1,\"#00B0F0\",2,\"#FFD400\",3,\"#FF7F00\",4,\"#E00000\",\"#404040\")"
        },
        "type": "expr"
      }
    },
    "custom.Blink": {
      "binding": {
        "config": {
          "expression": "if({view.custom.Unack}=1, floor(toMillis(now(500))/500)%2, 0)"
        },
        "type": "expr"
      }
    },
    "custom.IndState": {
      "binding": {
        "config": {
          "expression": "if(({view.custom.Notify}=0 && {view.custom.Inh}),10,{view.custom.Notify})"
        },
        "type": "expr"
      }
    },
    "custom.Exc": {
      "binding": {
        "config": {
          "expression": "if({view.custom.Fault}>=20,{view.custom.Fault},if(floor({view.custom.SrcQ}/8)%2=1,1,if(floor({view.custom.SrcQ}/16)%2=1,2,0)))"
        },
        "type": "expr"
      }
    },
    "custom.Frac": {
      "binding": {
        "config": {
          "expression": "if({view.custom.EUMax}>{view.custom.EUMin},max(0,min(1,({view.custom.PV}-{view.custom.EUMin})/max(0.000001,{view.custom.EUMax}-{view.custom.EUMin}))),1)"
        },
        "type": "expr"
      }
    },
    "custom.Flash": {
      "binding": {
        "config": {
          "expression": "floor(toMillis(now(1000))/1000)%2"
        },
        "type": "expr"
      }
    },
    "custom.InHiHi": {
      "binding": {
        "config": {
          "expression": "{view.custom.EUMin}<={view.custom.HiHiLim} && {view.custom.HiHiLim}<={view.custom.EUMax}"
        },
        "type": "expr"
      }
    },
    "custom.ShowHiHi": {
      "binding": {
        "config": {
          "expression": "{view.custom.AHiHi} && {view.custom.InHiHi}"
        },
        "type": "expr"
      }
    },
    "custom.FillHiHi": {
      "binding": {
        "config": {
          "expression": "if({view.custom.AHiHi},\"#FFAB73\",\"#B8B8B8\")"
        },
        "type": "expr"
      }
    },
    "custom.InHi": {
      "binding": {
        "config": {
          "expression": "{view.custom.EUMin}<={view.custom.HiLim} && {view.custom.HiLim}<={view.custom.EUMax}"
        },
        "type": "expr"
      }
    },
    "custom.ShowHi": {
      "binding": {
        "config": {
          "expression": "{view.custom.AHi} && {view.custom.InHi}"
        },
        "type": "expr"
      }
    },
    "custom.FillHi": {
      "binding": {
        "config": {
          "expression": "if({view.custom.AHi},\"#F2C200\",\"#D6D6D6\")"
        },
        "type": "expr"
      }
    },
    "custom.InLo": {
      "binding": {
        "config": {
          "expression": "{view.custom.EUMin}<={view.custom.LoLim} && {view.custom.LoLim}<={view.custom.EUMax}"
        },
        "type": "expr"
      }
    },
    "custom.ShowLo": {
      "binding": {
        "config": {
          "expression": "{view.custom.ALo} && {view.custom.InLo}"
        },
        "type": "expr"
      }
    },
    "custom.FillLo": {
      "binding": {
        "config": {
          "expression": "if({view.custom.ALo},\"#F2C200\",\"#D6D6D6\")"
        },
        "type": "expr"
      }
    },
    "custom.InLoLo": {
      "binding": {
        "config": {
          "expression": "{view.custom.EUMin}<={view.custom.LoLoLim} && {view.custom.LoLoLim}<={view.custom.EUMax}"
        },
        "type": "expr"
      }
    },
    "custom.ShowLoLo": {
      "binding": {
        "config": {
          "expression": "{view.custom.ALoLo} && {view.custom.InLoLo}"
        },
        "type": "expr"
      }
    },
    "custom.FillLoLo": {
      "binding": {
        "config": {
          "expression": "if({view.custom.ALoLo},\"#FFAB73\",\"#B8B8B8\")"
        },
        "type": "expr"
      }
    },
    "custom.ShowAny": {
      "binding": {
        "config": {
          "expression": "{view.custom.ShowHiHi} || {view.custom.ShowHi} || {view.custom.ShowLo} || {view.custom.ShowLoLo}"
        },
        "type": "expr"
      }
    },
    "custom.BdrOuter": {
      "binding": {
        "config": {
          "expression": "if({view.custom.Flash}=0,if({view.custom.ShowHiHi} || {view.custom.ShowLoLo},\"#FFAB73\",\"#F2C200\"),\"#9A9A9A\")"
        },
        "type": "expr"
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
