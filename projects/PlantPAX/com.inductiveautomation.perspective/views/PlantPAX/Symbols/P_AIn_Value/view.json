            "binding": {
              "config": {
                "expression": "{view.custom.EU}"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Alarm"
        },
        "position": {
          "x": 0,
          "y": 54,
          "width": 150,
          "height": 16
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "11px",
            "color": "#000000",
            "overflow": "hidden",
            "whiteSpace": "nowrap",
            "fontWeight": "bold",
            "border": "1px solid #404040",
            "boxSizing": "border-box"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "switch({view.custom.Fault},20,\"LOW\",21,\"HIGH\",24,\"LOW LOW\",25,\"HIGH HIGH\",32,\"FAIL\",34,\"CONFIG ERROR\",\"\")"
              },
              "type": "expr"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "len(switch({view.custom.Fault},20,\"LOW\",21,\"HIGH\",24,\"LOW LOW\",25,\"HIGH HIGH\",32,\"FAIL\",34,\"CONFIG ERROR\",\"\"))>0"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.custom.Sev}>0,{view.custom.SevColor},\"#FFF3B0\")"
              },
              "type": "expr"
            }
          }
        }
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\ttp = self.view.params.tagPath\n\tsystem.perspective.openPopup('AIn_' + tp, 'PlantPAX/Faceplates/P_AIn_Faceplate', params={'tagPath': tp},\n\t    title='P_AIn  ' + tp.split('/')[-1], position={'width': 660, 'height': 520}, showCloseIcon=True, draggable=True, resizable=False, modal=False, viewPortBound=True)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    }
  }
}