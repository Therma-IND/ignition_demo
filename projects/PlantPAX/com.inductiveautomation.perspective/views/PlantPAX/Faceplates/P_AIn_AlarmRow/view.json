            "binding": {
              "config": {
                "expression": "{view.custom.Suppr}"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "meta": {
          "name": "Ack"
        },
        "position": {
          "x": 302,
          "y": 3,
          "width": 50,
          "height": 26
        },
        "props": {
          "text": "Ack",
          "style": {
            "fontSize": "12px"
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.RdyAck}"
              },
              "type": "expr"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.tag.writeBlocking([self.view.params.tagPath + '/OCmd_Ack'],[True])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "meta": {
          "name": "Reset"
        },
        "position": {
          "x": 356,
          "y": 3,
          "width": 50,
          "height": 26
        },
        "props": {
          "text": "Reset",
          "style": {
            "fontSize": "12px"
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.RdyReset}"
              },
              "type": "expr"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.tag.writeBlocking([self.view.params.tagPath + '/OCmd_Reset'],[True])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "meta": {
          "name": "Shelve"
        },
        "position": {
          "x": 410,
          "y": 3,
          "width": 72,
          "height": 26
        },
        "props": {
          "text": "Shelve",
          "style": {
            "fontSize": "12px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.custom.Shelved},\"Unshelve\",\"Shelve\")"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.RdyShelve} || {view.custom.RdyUnshelve}"
              },
              "type": "expr"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tp = self.view.params.tagPath\n\tcmd = 'OCmd_Unshelve' if self.view.custom.Shelved else 'OCmd_Shelve'\n\tsystem.tag.writeBlocking([p + '/' + cmd], [True])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "meta": {
          "name": "EnDis"
        },
        "position": {
          "x": 486,
          "y": 3,
          "width": 72,
          "height": 26
        },
        "props": {
          "text": "Disable",
          "style": {
            "fontSize": "12px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.custom.Disabled},\"Enable\",\"Disable\")"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.RdyEnable} || {view.custom.RdyDisable}"
              },
              "type": "expr"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tp = self.view.params.tagPath\n\tcmd = 'MCmd_Enable' if self.view.custom.Disabled else 'MCmd_Disable'\n\tsystem.tag.writeBlocking([p + '/' + cmd], [True])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        }
      }
    ]
  }
}