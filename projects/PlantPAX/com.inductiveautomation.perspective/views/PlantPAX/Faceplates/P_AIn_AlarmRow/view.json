          "style": {
            "fontSize": "10px",
            "color": "#000000",
            "overflow": "hidden",
            "whiteSpace": "nowrap",
            "fontWeight": "bold",
            "backgroundColor": "#C8A8FF",
            "border": "1px solid #404040",
            "boxSizing": "border-box"
          },
          "textStyle": {
