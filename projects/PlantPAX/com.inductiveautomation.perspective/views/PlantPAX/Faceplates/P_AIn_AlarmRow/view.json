          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.Shelved}"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "AD_SuppressedIcon"
        },
        "position": {
          "x": 278,
          "y": 4,
          "width": 18,
          "height": 22
        },
        "props": {
